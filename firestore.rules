rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Owner = flag isOwner, impostabile SOLO manualmente dalla console
    // Firebase (non compare in nessuna allow update dell'app, quindi e'
    // immutabile via app). E' l'unico che puo' promuovere/rimuovere admin.
    function isOwner() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isOwner', false) == true;
    }

    // Admin = flag isAdmin sul proprio documento utente. Modificabile
    // SOLO dall'owner (vedi rules di /users): mai impostabile alla
    // creazione, mai auto-assegnabile, e nemmeno un admin puo' toccarlo.
    // L'owner e' sempre anche admin, senza bisogno del flag isAdmin.
    function isAdmin() {
      return signedIn()
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
            || isOwner());
    }

    // Whitelist: l'accesso ai dati richiede un account approvato da un admin.
    // 'approved' non esiste alla registrazione (utente in attesa) e può
    // essere impostato solo da un admin (vedi rules di /users).
    function isApproved() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approved', false) == true;
    }

    function validStatus(s) {
      return s in ['active', 'inactive', 'maintenance', 'unknown'];
    }

    function validPayload(p) {
      return p.keys().hasAll(['name', 'category', 'subcategory', 'status', 'description', 'lat', 'lng', 'photoFileIds'])
        && p.keys().hasOnly(['name', 'category', 'subcategory', 'status', 'description', 'lat', 'lng', 'photoFileIds'])
        && p.name is string && p.name.size() >= 1 && p.name.size() <= 100
        && p.category is string
        && p.subcategory is string && p.subcategory.size() <= 50
        && exists(/databases/$(database)/documents/categories/$(p.category))
        && validStatus(p.status)
        && p.description is string && p.description.size() <= 1000
        && p.lat is number && p.lat >= -90 && p.lat <= 90
        && p.lng is number && p.lng >= -180 && p.lng <= 180
        && p.photoFileIds is list && p.photoFileIds.size() <= 5;
    }

    // I punti sono scrivibili solo dagli admin (l'approvazione di una
    // proposta avviene lato client admin con una batch write).
    match /points/{pointId} {
      allow read: if isApproved() || isAdmin();
      allow create, update, delete: if isAdmin();

      // Note interne, mai visibili a chi non e' admin: sottocollezione
      // separata (non un campo su points) cosi' le rules bloccano la
      // lettura a livello di database, non solo nell'interfaccia.
      match /adminComments/{commentId} {
        allow read, delete: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }
    }

    match /categories/{categoryId} {
      allow read: if isApproved() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Gli utenti normali possono SOLO creare proposte (mai toccare points).
    match /suggestions/{suggestionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isApproved()
        && request.resource.data.keys().hasAll(['type', 'pointId', 'payload', 'note', 'authorUid', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['type', 'pointId', 'payload', 'note', 'authorUid', 'status', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['add', 'edit', 'remove']
        && (request.resource.data.type == 'add'
              ? request.resource.data.pointId == null
              : (request.resource.data.pointId is string
                 && exists(/databases/$(database)/documents/points/$(request.resource.data.pointId))))
        // Per 'remove' il payload contiene solo il nome (snapshot per la coda admin).
        && (request.resource.data.type == 'remove'
              ? (request.resource.data.payload.keys().hasOnly(['name'])
                 && request.resource.data.payload.name is string
                 && request.resource.data.payload.name.size() <= 100)
              : validPayload(request.resource.data.payload))
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt == request.time;
      // Solo transizione pending -> approved/rejected, solo admin.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.authorUid == request.auth.uid && resource.data.status == 'pending');
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // Alla creazione isAdmin non può esistere.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 50;
      // Se stessi: solo displayName. Admin: solo whitelist (approved/rejected),
      // mai isAdmin. Owner: solo il flag isAdmin altrui (mai il proprio, mai
      // quello di un altro owner) - la whitelist resta agli admin normali.
      allow update: if (isSelf(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 1
            && request.resource.data.displayName.size() <= 50)
        || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'rejected']))
        || (isOwner() && !isSelf(uid)
            && resource.data.get('isOwner', false) != true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAdmin']));
      // Diritto alla cancellazione (GDPR art. 17): solo l'interessato puo' cancellare
      // il proprio profilo. Gli admin non possono cancellare profili altrui.
      allow delete: if isSelf(uid);
    }
  }
}
