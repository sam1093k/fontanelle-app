# Copia questo file in .env.local e compila i valori.
# Config Firebase: Console Firebase -> Impostazioni progetto -> Le tue app -> Web app.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=

# URL del Cloudflare Worker per le foto (dopo `wrangler deploy`), senza slash finale.
# Es: https://mio-worker.tuo-account.workers.dev
VITE_WORKER_URL=

# Anti-bot (App Check + reCAPTCHA v3, invisibile). Site key da:
# https://www.google.com/recaptcha/admin (tipo "v3", aggiungi anche il
# dominio "localhost" per lo sviluppo locale), poi registrata anche in
# Firebase Console -> App Check -> Le tue app -> Web app -> reCAPTCHA v3.
# Se lasciata vuota, l'app funziona normalmente ma senza protezione anti-bot.
VITE_RECAPTCHA_SITE_KEY=
