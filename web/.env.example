# Copia questo file in .env.local e compila i valori.
# Config Firebase: Console Firebase -> Impostazioni progetto -> Le tue app -> Web app.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=

# URL del Cloudflare Worker per le foto (dopo `wrangler deploy`), senza slash finale.
# Es: https://your-worker-name.tuo-account.workers.dev
VITE_WORKER_URL=
